  "groups": [
    {
      "name": "20 kHz current step - five signals",
      "acquisition": "recorder",
      "recorder": {
        "trigger": {
          "enabled": true,
          "source": "g_tune_reference",
          "level": 0.25,
          "pre_trigger_samples": 200
        }
      },
      "plots": [
        {
          "name": "Control voltage (V) and saturation",
          "series": [
            {
              "variable": "g_tune_saturated"
            },
            {
              "variable": "g_tune_voltage"
            }
          ]
        },
